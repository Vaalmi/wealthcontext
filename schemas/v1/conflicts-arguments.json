{
  "$id": "https://wealthcontext.example/schemas/v1/conflicts-arguments.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "household_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Household Id",
      "type": "string"
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Known As Of"
    }
  },
  "required": [
    "as_of",
    "household_id"
  ],
  "title": "ConflictArguments",
  "type": "object"
}
