  "$id": "https://wealthcontext.example/schemas/v1/quality-arguments.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
