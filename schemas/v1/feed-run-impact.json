{
  "$defs": {
    "AffectedAccount": {
      "additionalProperties": false,
      "description": "An expected account whose publication from this run is unavailable; IDs only.\n\n`account_id` is the canonical account the external account resolves to through the\nCRM crosswalk at the run's business date and the cutoff; `manifest_account_id` is the\nlabel the manifest used (null when the manifest omitted the account).",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Account Id"
        },
        "household_attribution": {
          "enum": [
            "RESOLVED",
            "CROSSWALK_UNAVAILABLE",
            "HOUSEHOLD_UNAVAILABLE",
            "AMBIGUOUS"
          ],
          "title": "Household Attribution",
          "type": "string"
        },
        "household_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Household Id"
        },
        "manifest_account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Account Id"
        },
        "reason": {
          "enum": [
            "ACCOUNT_MANIFEST_MISMATCH",
            "SNAPSHOT_VALIDITY_MISMATCH",
            "DUPLICATE_ACCOUNT_COMPONENT",
            "INVALID_ACCOUNT_ROW",
            "EXPECTED_ACCOUNT_MISSING_FROM_MANIFEST",
            "OTHER"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "manifest_account_id",
        "reason",
        "household_id",
        "household_attribution"
      ],
      "title": "AffectedAccount",
      "type": "object"
    },
    "AffectedHousehold": {
      "additionalProperties": false,
      "properties": {
        "household_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Household Id",
          "type": "string"
        }
      },
      "required": [
        "household_id"
      ],
      "title": "AffectedHousehold",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "NOT_AUTHORIZED",
            "NOT_FOUND",
            "INVALID_ARGUMENT",
            "AS_OF_OUT_OF_RANGE",
            "UNSUPPORTED_CURRENCY",
            "RESULT_TOO_LARGE",
            "POLICY_UNAVAILABLE",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "title": "Error",
      "type": "object"
    },
    "FeedRunImpactData": {
      "additionalProperties": false,
      "description": "One run and, for a snapshot feed, the accounts and households it left unavailable.",
      "properties": {
        "accepted_records": {
          "minimum": 0,
          "title": "Accepted Records",
          "type": "integer"
        },
        "account_attribution": {
          "enum": [
            "MANIFEST",
            "NOT_ATTRIBUTABLE"
          ],
          "title": "Account Attribution",
          "type": "string"
        },
        "affected_account_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Account Count"
        },
        "affected_accounts": {
          "anyOf": [
            {
              "$ref": "#/$defs/SurfaceList_AffectedAccount_"
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_household_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Household Count"
        },
        "affected_households": {
          "anyOf": [
            {
              "$ref": "#/$defs/SurfaceList_AffectedHousehold_"
            },
            {
              "type": "null"
            }
          ]
        },
        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "committed_account_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Committed Account Count"
        },
        "expected_account_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Account Count"
        },
        "feed": {
          "enum": [
            "crm",
            "custody_accounts",
            "securities",
            "pas_snapshots",
            "custody_snapshots",
            "prices",
            "transactions",
            "lots",
            "fx"
          ],
          "title": "Feed",
          "type": "string"
        },
        "file_received": {
          "title": "File Received",
          "type": "boolean"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "rejected_records": {
          "minimum": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_system": {
          "enum": [
            "CRM",
            "PAS-A",
            "PAS-B",
            "CUSTODY-A",
            "CUSTODY-B",
            "FX",
            "SECMASTER"
          ],
          "title": "Source System",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT"
          ],
          "title": "Status",
          "type": "string"
        },
        "unattributed_account_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unattributed Account Count"
        },
        "upstream_status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT"
          ],
          "title": "Upstream Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "source_system",
        "feed",
        "business_date",
        "status",
        "upstream_status",
        "recorded_at",
        "file_received",
        "accepted_records",
        "rejected_records",
        "account_attribution",
        "expected_account_count",
        "committed_account_count",
        "affected_account_count",
        "affected_household_count",
        "unattributed_account_count",
        "affected_accounts",
        "affected_households"
      ],
      "title": "FeedRunImpactData",
      "type": "object"
    },
    "JsonValue": {},
    "QualityFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AMBIGUOUS",
            "AMBIGUOUS_ENTITY",
            "PRICE_STALE",
            "SOURCE_UNAVAILABLE",
            "FX_UNAVAILABLE",
            "HOUSEHOLD_MEMBERSHIP_CONFLICT",
            "REPORTING_HOUSEHOLD_CONFLICT",
            "OWNERSHIP_CONFLICT",
            "OWNERSHIP_UNAVAILABLE",
            "PENDING_SETTLEMENT",
            "QUANTITY_BREAK",
            "CASH_BREAK",
            "RECONCILIATION_UNAVAILABLE",
            "PRICE_SOURCE_MISMATCH",
            "CLOSED_ACCOUNT_WITH_BALANCE",
            "HELD_AWAY_EXCLUDED"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Detail",
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subject",
        "detail"
      ],
      "title": "QualityFlag",
      "type": "object"
    },
    "SurfaceList_AffectedAccount_": {
      "additionalProperties": false,
      "properties": {
        "item_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/AffectedAccount"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "default": null,
          "title": "Next Cursor",
          "type": "null"
        },
        "ordering": {
          "title": "Ordering",
          "type": "string"
        },
        "total_item_count": {
          "minimum": 0,
          "title": "Total Item Count",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "item_count",
        "total_item_count",
        "ordering",
        "truncated",
        "next_cursor"
      ],
      "title": "SurfaceList[AffectedAccount]",
      "type": "object"
    },
    "SurfaceList_AffectedHousehold_": {
      "additionalProperties": false,
      "properties": {
        "item_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/AffectedHousehold"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "default": null,
          "title": "Next Cursor",
          "type": "null"
        },
        "ordering": {
          "title": "Ordering",
          "type": "string"
        },
        "total_item_count": {
          "minimum": 0,
          "title": "Total Item Count",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "item_count",
        "total_item_count",
        "ordering",
        "truncated",
        "next_cursor"
      ],
      "title": "SurfaceList[AffectedHousehold]",
      "type": "object"
    }
  },
  "$id": "https://wealthcontext.example/schemas/v1/feed-run-impact.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "data": {
            "type": "object"
          },
          "entitlement_revision": {
            "minimum": 0,
            "type": "integer"
          },
          "error": {
            "type": "null"
          },
          "policy_revision": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedRunImpactData"
        },
        {
          "type": "null"
        }
      ]
    },
    "entitlement_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entitlement Revision"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Known As Of"
    },
    "metric_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Metric Refs",
      "type": "array"
    },
    "policy_revision": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Revision"
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Result Id",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Trace Id",
      "type": "string"
    },
    "valuation_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valuation Date"
    }
  },
  "required": [
    "contract_version",
    "trace_id",
    "result_id",
    "status",
    "as_of",
    "valuation_date",
    "known_as_of",
    "calculated_at",
    "entitlement_revision",
    "policy_revision",
    "data",
    "quality_flags",
    "source_refs",
    "metric_refs",
    "error"
  ],
  "title": "Envelope[FeedRunImpactData]",
  "type": "object"
}
