{
  "$id": "https://wealthcontext.example/schemas/v1/feed-run-impact-arguments.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Known As Of"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "FeedRunImpactArguments",
  "type": "object"
}
