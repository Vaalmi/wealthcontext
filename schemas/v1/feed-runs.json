{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "NOT_AUTHORIZED",
            "NOT_FOUND",
            "INVALID_ARGUMENT",
            "AS_OF_OUT_OF_RANGE",
            "UNSUPPORTED_CURRENCY",
            "RESULT_TOO_LARGE",
            "POLICY_UNAVAILABLE",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "title": "Error",
      "type": "object"
    },
    "FeedReject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "raw_payload": {
          "const": "[REDACTED]",
          "default": "[REDACTED]",
          "title": "Raw Payload",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "raw_payload"
      ],
      "title": "FeedReject",
      "type": "object"
    },
    "FeedRunItem": {
      "additionalProperties": false,
      "properties": {
        "accepted_records": {
          "minimum": 0,
          "title": "Accepted Records",
          "type": "integer"
        },
        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "feed": {
          "enum": [
            "crm",
            "custody_accounts",
            "securities",
            "pas_snapshots",
            "custody_snapshots",
            "prices",
            "transactions",
            "lots",
            "fx"
          ],
          "title": "Feed",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "rejected_records": {
          "minimum": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "rejects": {
          "$ref": "#/$defs/SurfaceList_FeedReject_"
        },
        "source_system": {
          "enum": [
            "CRM",
            "PAS-A",
            "PAS-B",
            "CUSTODY-A",
            "CUSTODY-B",
            "FX",
            "SECMASTER"
          ],
          "title": "Source System",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT"
          ],
          "title": "Status",
          "type": "string"
        },
        "upstream_status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT"
          ],
          "title": "Upstream Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_system",
        "feed",
        "business_date",
        "status",
        "upstream_status",
        "recorded_at",
        "imported_at",
        "accepted_records",
        "rejected_records",
        "content_hash",
        "rejects"
      ],
      "title": "FeedRunItem",
      "type": "object"
    },
    "JsonValue": {},
    "QualityFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AMBIGUOUS",
            "AMBIGUOUS_ENTITY",
            "PRICE_STALE",
            "SOURCE_UNAVAILABLE",
            "FX_UNAVAILABLE",
            "HOUSEHOLD_MEMBERSHIP_CONFLICT",
            "REPORTING_HOUSEHOLD_CONFLICT",
            "OWNERSHIP_CONFLICT",
            "OWNERSHIP_UNAVAILABLE",
            "PENDING_SETTLEMENT",
            "QUANTITY_BREAK",
            "CASH_BREAK",
            "RECONCILIATION_UNAVAILABLE",
            "PRICE_SOURCE_MISMATCH",
            "CLOSED_ACCOUNT_WITH_BALANCE",
            "HELD_AWAY_EXCLUDED"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Detail",
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subject",
        "detail"
      ],
      "title": "QualityFlag",
      "type": "object"
    },
    "SurfaceList_FeedReject_": {
      "additionalProperties": false,
      "properties": {
        "item_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/FeedReject"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "default": null,
          "title": "Next Cursor",
          "type": "null"
        },
        "ordering": {
          "title": "Ordering",
          "type": "string"
        },
        "total_item_count": {
          "minimum": 0,
          "title": "Total Item Count",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "item_count",
        "total_item_count",
        "ordering",
        "truncated",
        "next_cursor"
      ],
      "title": "SurfaceList[FeedReject]",
      "type": "object"
    },
    "SurfaceList_FeedRunItem_": {
      "additionalProperties": false,
      "properties": {
        "item_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/FeedRunItem"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "default": null,
          "title": "Next Cursor",
          "type": "null"
        },
        "ordering": {
          "title": "Ordering",
          "type": "string"
        },
        "total_item_count": {
          "minimum": 0,
          "title": "Total Item Count",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "item_count",
        "total_item_count",
        "ordering",
        "truncated",
        "next_cursor"
      ],
      "title": "SurfaceList[FeedRunItem]",
      "type": "object"
    }
  },
  "$id": "https://wealthcontext.example/schemas/v1/feed-runs.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "data": {
            "type": "object"
          },
          "entitlement_revision": {
            "minimum": 0,
            "type": "integer"
          },
          "error": {
            "type": "null"
          },
          "policy_revision": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/SurfaceList_FeedRunItem_"
        },
        {
          "type": "null"
        }
      ]
    },
    "entitlement_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entitlement Revision"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Known As Of"
    },
    "metric_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Metric Refs",
      "type": "array"
    },
    "policy_revision": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Revision"
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Result Id",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Trace Id",
      "type": "string"
    },
    "valuation_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valuation Date"
    }
  },
  "required": [
    "contract_version",
    "trace_id",
    "result_id",
    "status",
    "as_of",
    "valuation_date",
    "known_as_of",
    "calculated_at",
    "entitlement_revision",
    "policy_revision",
    "data",
    "quality_flags",
    "source_refs",
    "metric_refs",
    "error"
  ],
  "title": "Envelope[SurfaceList[FeedRunItem]]",
  "type": "object"
}
