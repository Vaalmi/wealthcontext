{
  "$defs": {
    "Caveat": {
      "additionalProperties": false,
      "properties": {
        "flag": {
          "enum": [
            "AMBIGUOUS",
            "AMBIGUOUS_ENTITY",
            "PRICE_STALE",
            "SOURCE_UNAVAILABLE",
            "FX_UNAVAILABLE",
            "HOUSEHOLD_MEMBERSHIP_CONFLICT",
            "REPORTING_HOUSEHOLD_CONFLICT",
            "OWNERSHIP_CONFLICT",
            "OWNERSHIP_UNAVAILABLE",
            "PENDING_SETTLEMENT",
            "QUANTITY_BREAK",
            "CASH_BREAK",
            "RECONCILIATION_UNAVAILABLE",
            "PRICE_SOURCE_MISMATCH",
            "CLOSED_ACCOUNT_WITH_BALANCE",
            "HELD_AWAY_EXCLUDED"
          ],
          "title": "Flag",
          "type": "string"
        },
        "subject": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "flag",
        "subject"
      ],
      "title": "Caveat",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityReference"
        },
        "field": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Field",
          "type": "string"
        },
        "format": {
          "enum": [
            "value_only",
            "label_and_value"
          ],
          "title": "Format",
          "type": "string"
        },
        "household_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Household Id"
        },
        "id": {
          "pattern": "^c[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        },
        "unit": {
          "enum": [
            "USD",
            "pct",
            "count",
            "shares",
            "fx_rate",
            "days"
          ],
          "title": "Unit",
          "type": "string"
        },
        "valuation_date": {
          "format": "date",
          "title": "Valuation Date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "result_id",
        "entity",
        "field",
        "household_id",
        "valuation_date",
        "unit",
        "format"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CompletenessPredicate": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityReference"
        },
        "expect": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ],
          "title": "Expect",
          "type": "string"
        },
        "field": {
          "const": "status",
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^p[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "completeness",
          "title": "Kind",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "result_id",
        "entity",
        "kind",
        "field",
        "expect"
      ],
      "title": "CompletenessPredicate",
      "type": "object"
    },
    "EntityReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "result_summary",
            "household",
            "account",
            "issuer",
            "security",
            "position",
            "lot",
            "transaction",
            "feed_run"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "EntityReference",
      "type": "object"
    },
    "RankPredicate": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityReference"
        },
        "expect": {
          "minimum": 1,
          "title": "Expect",
          "type": "integer"
        },
        "field": {
          "const": "rank",
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^p[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "rank",
          "title": "Kind",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "result_id",
        "entity",
        "kind",
        "field",
        "expect"
      ],
      "title": "RankPredicate",
      "type": "object"
    },
    "ReconciliationPredicate": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityReference"
        },
        "expect": {
          "enum": [
            "MATCHED",
            "PENDING_SETTLEMENT",
            "BREAK",
            "RECONCILIATION_UNAVAILABLE"
          ],
          "title": "Expect",
          "type": "string"
        },
        "field": {
          "const": "reconciliation_status",
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^p[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "reconciliation",
          "title": "Kind",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "result_id",
        "entity",
        "kind",
        "field",
        "expect"
      ],
      "title": "ReconciliationPredicate",
      "type": "object"
    },
    "Refusal": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "NOT_AUTHORIZED",
            "NOT_FOUND",
            "INVALID_ARGUMENT",
            "AS_OF_OUT_OF_RANGE",
            "UNSUPPORTED_CURRENCY",
            "RESULT_TOO_LARGE",
            "POLICY_UNAVAILABLE",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "result_id"
      ],
      "title": "Refusal",
      "type": "object"
    },
    "ThresholdPredicate": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityReference"
        },
        "expect": {
          "enum": [
            "AT_OR_ABOVE",
            "BELOW"
          ],
          "title": "Expect",
          "type": "string"
        },
        "field": {
          "const": "applied_threshold_pct",
          "title": "Field",
          "type": "string"
        },
        "id": {
          "pattern": "^p[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "threshold",
          "title": "Kind",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "result_id",
        "entity",
        "kind",
        "field",
        "expect"
      ],
      "title": "ThresholdPredicate",
      "type": "object"
    }
  },
  "$id": "https://wealthcontext.example/schemas/v1/answer.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer_markdown": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Answer Markdown",
      "type": "string"
    },
    "caveats": {
      "items": {
        "$ref": "#/$defs/Caveat"
      },
      "maxItems": 100,
      "title": "Caveats",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 60,
      "title": "Claims",
      "type": "array"
    },
    "predicates": {
      "items": {
        "discriminator": {
          "mapping": {
            "completeness": "#/$defs/CompletenessPredicate",
            "rank": "#/$defs/RankPredicate",
            "reconciliation": "#/$defs/ReconciliationPredicate",
            "threshold": "#/$defs/ThresholdPredicate"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RankPredicate"
          },
          {
            "$ref": "#/$defs/ThresholdPredicate"
          },
          {
            "$ref": "#/$defs/CompletenessPredicate"
          },
          {
            "$ref": "#/$defs/ReconciliationPredicate"
          }
        ]
      },
      "maxItems": 60,
      "title": "Predicates",
      "type": "array"
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Refusal"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "answer_markdown",
    "claims",
    "predicates",
    "caveats",
    "refusal"
  ],
  "title": "Answer",
  "type": "object"
}
