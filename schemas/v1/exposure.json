          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "item_count",
        "total_item_count",
        "truncated",
        "next_cursor",
        "items",
        "ordering",
        "rank_scope"
