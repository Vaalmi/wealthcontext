{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHENTICATED",
            "NOT_AUTHORIZED",
            "NOT_FOUND",
            "INVALID_ARGUMENT",
            "AS_OF_OUT_OF_RANGE",
            "UNSUPPORTED_CURRENCY",
            "RESULT_TOO_LARGE",
            "POLICY_UNAVAILABLE",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "title": "Error",
      "type": "object"
    },
    "FeedHealthCell": {
      "additionalProperties": false,
      "description": "One expected pair on one business day; the latest run at the cutoff, or none.",
      "properties": {
        "accepted_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted Records"
        },
        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "feed": {
          "enum": [
            "crm",
            "custody_accounts",
            "securities",
            "pas_snapshots",
            "custody_snapshots",
            "prices",
            "transactions",
            "lots",
            "fx"
          ],
          "title": "Feed",
          "type": "string"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recorded At"
        },
        "rejected_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rejected Records"
        },
        "run_count": {
          "minimum": 0,
          "title": "Run Count",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "source_system": {
          "enum": [
            "CRM",
            "PAS-A",
            "PAS-B",
            "CUSTODY-A",
            "CUSTODY-B",
            "FX",
            "SECMASTER"
          ],
          "title": "Source System",
          "type": "string"
        },
        "state": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT",
            "NOT_RECEIVED"
          ],
          "title": "State",
          "type": "string"
        },
        "upstream_status": {
          "anyOf": [
            {
              "enum": [
                "SUCCESS",
                "PARTIAL",
                "FAILED",
                "TIMEOUT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Status"
        }
      },
      "required": [
        "source_system",
        "feed",
        "business_date",
        "state",
        "run_id",
        "upstream_status",
        "accepted_records",
        "rejected_records",
        "recorded_at",
        "run_count"
      ],
      "title": "FeedHealthCell",
      "type": "object"
    },
    "FeedHealthData": {
      "additionalProperties": false,
      "description": "Every expected cell of the range, at most 15 pairs by 25 business days.",
      "properties": {
        "business_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "maxItems": 25,
          "minItems": 1,
          "title": "Business Dates",
          "type": "array"
        },
        "business_day_count": {
          "maximum": 25,
          "minimum": 1,
          "title": "Business Day Count",
          "type": "integer"
        },
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        },
        "item_count": {
          "maximum": 375,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/FeedHealthCell"
          },
          "maxItems": 375,
          "title": "Items",
          "type": "array"
        },
        "ordering": {
          "title": "Ordering",
          "type": "string"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/FeedPair"
          },
          "maxItems": 15,
          "title": "Pairs",
          "type": "array"
        },
        "state_counts": {
          "items": {
            "$ref": "#/$defs/FeedStateCount"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "State Counts",
          "type": "array"
        },
        "total_item_count": {
          "minimum": 0,
          "title": "Total Item Count",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "date_from",
        "date_to",
        "business_dates",
        "business_day_count",
        "pairs",
        "items",
        "item_count",
        "total_item_count",
        "ordering",
        "truncated",
        "state_counts"
      ],
      "title": "FeedHealthData",
      "type": "object"
    },
    "FeedPair": {
      "additionalProperties": false,
      "properties": {
        "feed": {
          "enum": [
            "crm",
            "custody_accounts",
            "securities",
            "pas_snapshots",
            "custody_snapshots",
            "prices",
            "transactions",
            "lots",
            "fx"
          ],
          "title": "Feed",
          "type": "string"
        },
        "source_system": {
          "enum": [
            "CRM",
            "PAS-A",
            "PAS-B",
            "CUSTODY-A",
            "CUSTODY-B",
            "FX",
            "SECMASTER"
          ],
          "title": "Source System",
          "type": "string"
        }
      },
      "required": [
        "source_system",
        "feed"
      ],
      "title": "FeedPair",
      "type": "object"
    },
    "FeedStateCount": {
      "additionalProperties": false,
      "properties": {
        "cell_count": {
          "minimum": 0,
          "title": "Cell Count",
          "type": "integer"
        },
        "state": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "TIMEOUT",
            "NOT_RECEIVED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "cell_count"
      ],
      "title": "FeedStateCount",
      "type": "object"
    },
    "JsonValue": {},
    "QualityFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AMBIGUOUS",
            "AMBIGUOUS_ENTITY",
            "PRICE_STALE",
            "SOURCE_UNAVAILABLE",
            "FX_UNAVAILABLE",
            "HOUSEHOLD_MEMBERSHIP_CONFLICT",
            "REPORTING_HOUSEHOLD_CONFLICT",
            "OWNERSHIP_CONFLICT",
            "OWNERSHIP_UNAVAILABLE",
            "PENDING_SETTLEMENT",
            "QUANTITY_BREAK",
            "CASH_BREAK",
            "RECONCILIATION_UNAVAILABLE",
            "PRICE_SOURCE_MISMATCH",
            "CLOSED_ACCOUNT_WITH_BALANCE",
            "HELD_AWAY_EXCLUDED"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Detail",
          "type": "object"
        },
        "severity": {
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subject",
        "detail"
      ],
      "title": "QualityFlag",
      "type": "object"
    }
  },
  "$id": "https://wealthcontext.example/schemas/v1/feed-health.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "data": {
            "type": "object"
          },
          "entitlement_revision": {
            "minimum": 0,
            "type": "integer"
          },
          "error": {
            "type": "null"
          },
          "policy_revision": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedHealthData"
        },
        {
          "type": "null"
        }
      ]
    },
    "entitlement_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Entitlement Revision"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Known As Of"
    },
    "metric_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Metric Refs",
      "type": "array"
    },
    "policy_revision": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Revision"
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Result Id",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
      "title": "Trace Id",
      "type": "string"
    },
    "valuation_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valuation Date"
    }
  },
  "required": [
    "contract_version",
    "trace_id",
    "result_id",
    "status",
    "as_of",
    "valuation_date",
    "known_as_of",
    "calculated_at",
    "entitlement_revision",
    "policy_revision",
    "data",
    "quality_flags",
    "source_refs",
    "metric_refs",
    "error"
  ],
  "title": "Envelope[FeedHealthData]",
  "type": "object"
}
