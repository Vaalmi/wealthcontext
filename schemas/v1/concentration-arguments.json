{
  "$id": "https://wealthcontext.example/schemas/v1/concentration-arguments.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "household_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Household Id"
    },
    "known_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Known As Of"
    },
    "threshold_pct": {
      "default": "10.00",
      "maxLength": 5,
      "pattern": "^(?:(?:[1-9]|[1-4][0-9])(?:\\.[0-9]{1,2})?|50(?:\\.0{1,2})?)$",
      "title": "Threshold Pct",
      "type": "string"
    }
  },
  "required": [
    "as_of"
  ],
  "title": "ConcentrationArguments",
  "type": "object"
}
