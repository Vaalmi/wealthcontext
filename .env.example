# Optional: the app and replay work without provider keys.
# Configure only providers you intend to call. Keep actual values in ignored .env.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
WEALTHCONTEXT_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI GPT-6-Luna is the live-call default; effort is low, medium, high or xhigh.
# The scored gate's primary model is GPT-6.1 Terra (gpt-6.1-terra) at high, run with
# --model; GPT-6-Luna is its GPT comparison; Google live runs are deferred.
OPENAI_API_KEY=
WEALTHCONTEXT_OPENAI_MODEL=gpt-6-luna
WEALTHCONTEXT_OPENAI_REASONING_EFFORT=high
GEMINI_API_KEY=
WEALTHCONTEXT_GOOGLE_MODEL=gemini-3.8-flash
